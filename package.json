{
  "name": "shortly",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @shortly/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @shortly/api test:watch",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @shortly/api db:generate",
    "db:migrate": "pnpm --filter @shortly/api db:migrate",
    "db:deploy": "pnpm --filter @shortly/api db:deploy",
    "db:studio": "pnpm --filter @shortly/api db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
